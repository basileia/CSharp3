@page "/editToDoItem/{Id:int}"
@using ToDoList.Frontend.Models
@using ToDoList.Frontend.Clients
@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject IToDoItemsClient toDoItemsClient
@inject ICategoriesClient categoriesClient

<div class="container mt-3">
    <h2 class="mt-4">Upravit úkol</h2>

    @if (ToDoItemModel is not null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                Úprava úkolu: @ToDoItemModel.Name
            </div>

            <div class="card-body">
                <ToDoItemForm Model="ToDoItemModel" Categories="categories" SubmitText="Uložit změny" OnValidSubmit="Submit"
                    ErrorMessage="@errorMessage" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    public ToDoItemView ToDoItemModel { get; set; }
    private List<CategoryView> categories = [];
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var result = await toDoItemsClient.ReadItemByIdAsync(Id);
        if (result.IsSuccess)
        {
            ToDoItemModel = result.Value!;
        }
        else
            errorMessage = result.Error ?? "Nepodařilo se načíst úkol.";

        categories = await categoriesClient.GetCategoriesAsync();

    }
    public async Task Submit()
    {
        errorMessage = string.Empty;

        var result = await toDoItemsClient.UpdateAsync(ToDoItemModel);

        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            errorMessage = result.Error ?? "Nepodařilo se uložit změny.";
        }
    }
}
@using Microsoft.VisualBasic
@using ToDoList.Frontend.Clients
@using ToDoList.Frontend.Models
@rendermode InteractiveServer
@inject IToDoItemsClient toDoItemsClient
@inject NavigationManager NavigationManager

<div class="container">
    <h2 class="mt-4">Přehled úkolů</h2>

    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/addToDoItem")'>
            <i class="bi bi-plus-circle me-1"></i>
            Přidat úkol
        </button>
        <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/addCategory")'>
            <i class="bi bi-folder-plus me-1"></i>
            Přidat kategorii
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @ErrorMessage
        </div>
    }
    <table class="table table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th @onclick="OrderById" style="cursor:pointer">
                    ID @(sortByIdAsc ? "▲" : "▼")
                </th>
                <th @onclick="OrderByName" style="cursor:pointer">
                    Název @(sortByNameAsc ? "▲" : "▼")
                </th>
                <th>Popis</th>
                <th>Kategorie</th>
                <th>Dokončeno</th>
                <th>Akce</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in SortedData)
            {
                <tr class="@(item.IsCompleted ? "table-success" : "")">
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>@(item.CategoryName ?? "-")</td>
                    <td>@(item.IsCompleted ? "Ano" : "Ne")</td>
                    <td>
                        <div class="btn-group">
                            <button class="btn btn-primary btn-sm" title="Upravit" @onclick="() => EditItem(item)">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button class="btn btn-warning btn-sm" title="Přepnout dokončení"
                                @onclick="() => ToggleCompleted(item)">
                                @if (item.IsCompleted)
                                {
                                    <i class="bi bi-x-circle"></i>
                                }
                                else
                                {
                                    <i class="bi bi-check-circle"></i>
                                }
                            </button>

                            <button class="btn btn-danger btn-sm" title="Smazat"
                                @onclick="async () => await DeleteItem(item)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<ToDoItemView> SortedData = new List<ToDoItemView>();
    private bool sortByIdAsc = true;
    private bool sortByNameAsc = true;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        SortedData = await toDoItemsClient.ReadItemsAsync();
    }

    private void OrderByName()
    {
        SortedData = sortByNameAsc
        ? SortedData.OrderBy(item => item.Name).ToList()
        : SortedData.OrderByDescending(item => item.Name).ToList();

        sortByNameAsc = !sortByNameAsc;
        sortByIdAsc = true;
    }

    private void EditItem(ToDoItemView toDoItem)
    {
        NavigationManager.NavigateTo($"/editToDoItem/{toDoItem.Id}");
    }

    private void OrderById()
    {
        SortedData = sortByIdAsc
        ? SortedData.OrderBy(item => item.Id).ToList()
        : SortedData.OrderByDescending(item => item.Id).ToList();

        sortByIdAsc = !sortByIdAsc;
        sortByNameAsc = true;
    }

    private async Task ToggleCompleted(ToDoItemView item)
    {
        item.IsCompleted = !item.IsCompleted;
        ErrorMessage = string.Empty;

        var result = await toDoItemsClient.UpdateAsync(item);

        if (result.IsSuccess == false)
        {
            item.IsCompleted = !item.IsCompleted;
            ErrorMessage = result.Error ?? $"Nepodařilo se aktualizovat úkol '{item.Name}'.";
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task DeleteItem(ToDoItemView item)
    {
        ErrorMessage = string.Empty;
        var result = await toDoItemsClient.DeleteAsync(item.Id);

        if (result.IsSuccess)
        {
            SortedData.Remove(item);
            StateHasChanged();
        }
        else
        {
            ErrorMessage = result.Error ?? $"Nepodařilo se smazat úkol '{item.Name}'.";
        }
    }
}
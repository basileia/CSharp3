@using Microsoft.VisualBasic
@using ToDoList.Frontend.Models

<h2>ToDo Items Dashboard</h2>

<table class="table">
    <tr>
        <th @onclick="OrderById" style="cursor:pointer">
            ID @((sortByIdAsc ? "▲" : "▼"))
        </th>
        <th @onclick="OrderByName" style="cursor:pointer">
            Název @((sortByNameAsc ? "▲" : "▼"))
        </th>
        <th>Popis</th>
        <th>Dokončeno</th>
    </tr>
    <tbody>
        @foreach (var item in SortedData)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Description</td>
                <td>@(item.IsCompleted ? "Ano" : "Ne")</td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ToDoItemView> testData = new()
{
new ToDoItemView(1, "Nákup", "Koupit mléko a chléb", false),
new ToDoItemView(2, "Úklid", "Vysát a vytřít obývák", true),
new ToDoItemView(3, "Programování", "Dokončit Hangman projekt", false),
new ToDoItemView(4, "Cvičení", "Krátký workout 20 minut", false),
new ToDoItemView(5, "Telefonát", "Zavolat babičce", true)
};

    private List<ToDoItemView> SortedData = new List<ToDoItemView>();
    private bool sortByIdAsc = true;
    private bool sortByNameAsc = true;

    protected override void OnInitialized()
    {
        OrderByName();
    }

    private void OrderByName()
    {
        SortedData = sortByNameAsc
        ? testData.OrderBy(item => item.Name).ToList()
        : testData.OrderByDescending(item => item.Name).ToList();

        sortByNameAsc = !sortByNameAsc;
        sortByIdAsc = true;
    }

    private void OrderById()
    {
        SortedData = sortByIdAsc
        ? testData.OrderBy(item => item.Id).ToList()
        : testData.OrderByDescending(item => item.Id).ToList();

        sortByIdAsc = !sortByIdAsc;
        sortByNameAsc = true;
    }
}
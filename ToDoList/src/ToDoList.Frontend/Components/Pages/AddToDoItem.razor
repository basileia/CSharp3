@page "/addToDoItem"
@using ToDoList.Frontend.Models
@using ToDoList.Frontend.Clients

@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject IToDoItemsClient toDoItemsClient
@inject ICategoriesClient categoriesClient

<div class="container mt-3">
    <h2 class="mt-4">Přidat úkol</h2>

    @if (ToDoItemModel is not null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                Vytvoření nového úkolu
            </div>

            <div class="card-body">
                <ToDoItemForm Model="ToDoItemModel" Categories="Categories" SubmitText="Vytvořit" OnValidSubmit="Submit"
                    ErrorMessage="@ErrorMessage" />
            </div>
        </div>
    }
</div>

@code {
    public ToDoItemView ToDoItemModel { get; set; } = new ToDoItemView();
    private List<CategoryView> Categories = [];
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Categories = await categoriesClient.GetCategoriesAsync();
    }
    public async Task Submit()
    {
        ErrorMessage = string.Empty;

        var result = await toDoItemsClient.CreateAsync(ToDoItemModel);

        if (result.IsSuccess)
        {
            NavigationManager.NavigateTo("/");
        }
        else
        {
            ErrorMessage = result.Error ?? "Nepodařilo se vytvořit úkol.";
        }
    }
}